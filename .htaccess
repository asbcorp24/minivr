Options -Indexes
RewriteEngine On

# If the browser explicitly requested /public/..., redirect once to the clean URL.
# THE_REQUEST contains only the original HTTP request and is not changed by internal rewrites.
RewriteCond %{THE_REQUEST} "\s/+public(?:/([^?\s]*))?[?\s]" [NC]
RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]

# Never expose application internals from the repository root.
RewriteRule ^(?:config\.php|src(?:/|$)|data(?:/|$)|\.git(?:/|$)) - [F,L,NC]

# IMPORTANT: stop here after Apache has internally rewritten to public/.
RewriteRule ^public(?:/|$) - [L]

# Clean URL -> internal public/ path.
RewriteRule ^(.*)$ public/$1 [L]
