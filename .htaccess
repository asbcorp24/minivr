Options -Indexes
RewriteEngine On

# Redirect browser-visible /public URLs to clean URLs.
# THE_REQUEST prevents a redirect loop after the internal rewrite below.
RewriteCond %{THE_REQUEST} \s/+public(?:/([^?\s]*))? [NC]
RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]

# Never expose application internals.
RewriteRule ^(?:config\.php|src(?:/|$)|data(?:/|$)|\.git(?:/|$)) - [F,L,NC]

# Internally serve everything from /public.
RewriteRule ^(.*)$ public/$1 [L]
